Ngeneric:Invisible-Pin|pin@10||-30|44|||||SIM_spice_card(D5G1;)S["* ===== SRAM_tb: write 0 at 0x13 and 1 at 0xA7, read both back, then read the 0 at 0x13 again =====","* Test: write 13=0, write A7=1, read 13, read A7, read 13.  (A = 8-bit serial address, MSB first; 9 clock cycles per access)","* TSMC 0.18um BSIM3, TYPICAL corner (TT), VDD 1.8 V, 27 C.  Pass/fail is printed in the SPICE log:  RDk_xx = DOUT voltage, PASSk_xx = 1 if read k (address xx) is correct.","* Models: in Electric set  Preferences > Tools > Simulation (SPICE) > Spice Header Card Info = tsmc018.lib  (model file, as for the V1 test cells).","* Electric lambda must be 90 nm (library setting), so a 2-lambda gate is written L=0.18U.  Delete these 2 comment lines if you prefer an explicit .include.",.param VDD=1.8,.param TCLK=5n,.param TR=0.1n,.param TSTART=150n,.param T0={ceil(TSTART/TCLK)*TCLK},.param CLOAD=5p,.param TSTEP=50p,.param NTAIL=10          ; idle clock cycles kept running after the last read,.param TSTOP={T0+(9*5+3+NTAIL)*TCLK},.temp 27,.options plotwinsize=0 numdgt=7,.model DIO D(IS=1e-14 CJO=0.2p),Vdd vdd 0 PWL(0 0 10n {VDD}),VCLK_s CLK_s 0 PULSE(0 {VDD} {T0+0.5*TCLK} {TR} {TR} {0.5*TCLK-TR} {TCLK}),VRW_s RW_s 0 PWL(0 0 {T0+8*TCLK+TR} {0*VDD} {T0+8*TCLK+TR+TR} {1*VDD} {T0+9*TCLK+TR} {1*VDD} {T0+9*TCLK+TR+TR} {0*VDD} {T0+17*TCLK+TR} {0*VDD} {T0+17*TCLK+TR+TR} {1*VDD} {T0+18*TCLK+TR} {1*VDD} {T0+18*TCLK+TR+TR} {0*VDD}),VADDR_s ADDR_s 0 PWL(0 0 {T0+3*TCLK+TR} {0*VDD} {T0+3*TCLK+TR+TR} {1*VDD} {T0+4*TCLK+TR} {1*VDD} {T0+4*TCLK+TR+TR} {0*VDD} {T0+6*TCLK+TR} {0*VDD} {T0+6*TCLK+TR+TR} {1*VDD} {T0+8*TCLK+TR} {1*VDD} {T0+8*TCLK+TR+TR} {0*VDD} {T0+9*TCLK+TR} {0*VDD} {T0+9*TCLK+TR+TR} {1*VDD} {T0+10*TCLK+TR} {1*VDD} {T0+10*TCLK+TR+TR} {0*VDD} {T0+11*TCLK+TR} {0*VDD} {T0+11*TCLK+TR+TR} {1*VDD} {T0+12*TCLK+TR} {1*VDD} {T0+12*TCLK+TR+TR} {0*VDD} {T0+14*TCLK+TR} {0*VDD} {T0+14*TCLK+TR+TR} {1*VDD} {T0+17*TCLK+TR} {1*VDD} {T0+17*TCLK+TR+TR} {0*VDD} {T0+21*TCLK+TR} {0*VDD} {T0+21*TCLK+TR+TR} {1*VDD} {T0+22*TCLK+TR} {1*VDD} {T0+22*TCLK+TR+TR} {0*VDD} {T0+24*TCLK+TR} {0*VDD} {T0+24*TCLK+TR+TR} {1*VDD} {T0+26*TCLK+TR} {1*VDD} {T0+26*TCLK+TR+TR} {0*VDD} {T0+27*TCLK+TR} {0*VDD} {T0+27*TCLK+TR+TR} {1*VDD} {T0+28*TCLK+TR} {1*VDD} {T0+28*TCLK+TR+TR} {0*VDD} {T0+29*TCLK+TR} {0*VDD} {T0+29*TCLK+TR+TR} {1*VDD} {T0+30*TCLK+TR} {1*VDD} {T0+30*TCLK+TR+TR} {0*VDD} {T0+32*TCLK+TR} {0*VDD} {T0+32*TCLK+TR+TR} {1*VDD} {T0+35*TCLK+TR} {1*VDD} {T0+35*TCLK+TR+TR} {0*VDD} {T0+39*TCLK+TR} {0*VDD} {T0+39*TCLK+TR+TR} {1*VDD} {T0+40*TCLK+TR} {1*VDD} {T0+40*TCLK+TR+TR} {0*VDD} {T0+42*TCLK+TR} {0*VDD} {T0+42*TCLK+TR+TR} {1*VDD} {T0+44*TCLK+TR} {1*VDD} {T0+44*TCLK+TR+TR} {0*VDD}),VDIN_s DIN_s 0 PWL(0 0 {T0+17*TCLK+TR} {0*VDD} {T0+17*TCLK+TR+TR} {1*VDD} {T0+18*TCLK+TR} {1*VDD} {T0+18*TCLK+TR+TR} {0*VDD}),RCLK_s CLK_s CLK_p1 50,CCLK_pkg CLK_p1 0 0.5p,RCLK_b CLK_p1 CLK_p2 0.2,LCLK_b CLK_p2 CLK_p3 1.5n,CCLK_pad CLK_p3 0 1p,DCLK_1 CLK_p3 vdd DIO,DCLK_2 0 CLK_p3 DIO,RCLK_esd CLK_p3 CLK 150,CCLK_g CLK 0 20f,RRW_s RW_s RW_p1 50,CRW_pkg RW_p1 0 0.5p,RRW_b RW_p1 RW_p2 0.2,LRW_b RW_p2 RW_p3 1.5n,CRW_pad RW_p3 0 1p,DRW_1 RW_p3 vdd DIO,DRW_2 0 RW_p3 DIO,RRW_esd RW_p3 RW 150,CRW_g RW 0 20f,RADDR_s ADDR_s ADDR_p1 50,CADDR_pkg ADDR_p1 0 0.5p,RADDR_b ADDR_p1 ADDR_p2 0.2,LADDR_b ADDR_p2 ADDR_p3 1.5n,CADDR_pad ADDR_p3 0 1p,DADDR_1 ADDR_p3 vdd DIO,DADDR_2 0 ADDR_p3 DIO,RADDR_esd ADDR_p3 ADDR 150,CADDR_g ADDR 0 20f,RDIN_s DIN_s DIN_p1 50,CDIN_pkg DIN_p1 0 0.5p,RDIN_b DIN_p1 DIN_p2 0.2,LDIN_b DIN_p2 DIN_p3 1.5n,CDIN_pad DIN_p3 0 1p,DDIN_1 DIN_p3 vdd DIO,DDIN_2 0 DIN_p3 DIO,RDIN_esd DIN_p3 DIN 150,CDIN_g DIN 0 20f,Rdo_b DOUT dout_p1 0.2,Ldo_b dout_p1 dout_p2 1.5n,Cdo_pkg dout_p2 0 0.5p,Cdo_pad DOUT 0 1.2p,CL dout_p2 0 {CLOAD},.save V(dout) V(clk) V(addr) V(rw) V(din) I(Vdd),.tran 0 {TSTOP} 0 {TSTEP},.meas tran RD1_13 FIND V(dout) AT={T0+27.5*TCLK+0.95*TCLK},.meas tran PASS1_13 PARAM abs(RD1_13-0*VDD)<0.1*VDD,.meas tran RD2_A7 FIND V(dout) AT={T0+36.5*TCLK+0.95*TCLK},.meas tran PASS2_A7 PARAM abs(RD2_A7-1*VDD)<0.1*VD